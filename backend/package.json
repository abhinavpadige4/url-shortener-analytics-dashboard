{
  "name": "url-shortener-backend",
  "version": "1.0.0",
  "description": "Backend for URL shortener with analytics dashboard",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src --ext .ts"
  },
  "keywords": [
    "url-shortener",
    "analytics",
    "nodejs",
    "express",
    "typescript"
  ],
  "author": "URL Shortener Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.0",
    "prisma": "^5.2.0",
    "@prisma/client": "^5.2.0",
    "redis": "^4.6.7",
    "dotenv": "^16.3.1",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "rate-limiter-flexible": "^2.4.1",
    "shortid": "^2.2.16",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.5.0",
    "@types/pg": "^8.10.2",
    "@types/shortid": "^0.0.29",
    "@types/supertest": "^2.0.12",
    "jest": "^29.6.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6",
    "eslint": "^8.47.0",
    "prettier": "^3.0.2"
  }
}